{
  "name": "@multica/desktop-wails",
  "productName": "Multica Wails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multica desktop client hosted by Go and Wails v3.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:frontend": "vite build",
    "build:go": "node scripts/build-go.mjs",
    "build": "pnpm run build:frontend && pnpm run build:go",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "go test ./...",
    "lint": "eslint frontend vite.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@multica/core": "workspace:*",
    "@multica/ui": "workspace:*",
    "@multica/views": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@wailsio/runtime": "3.0.0-alpha.97",
    "lucide-react": "catalog:",
    "motion": "^12.38.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@multica/eslint-config": "workspace:*",
    "@multica/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.2",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vite": "^7.3.1"
  }
}
